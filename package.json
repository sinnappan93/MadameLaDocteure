{
  "name": "madameladocteure",
  "version": "0.1.0",
  "private": true,
  "description": "MadameLaDocteure - application personnelle de préparation au concours de conservateur du patrimoine (option Inde et monde indianisé).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "android:sync": "npm run build && npx cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "test:tout": "npm run typecheck && npm test && npm run build && npm run e2e"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.137.0",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.3",
    "@fontsource-variable/nunito": "5.3.0",
    "@fontsource/dancing-script": "5.3.0",
    "@huggingface/transformers": "3.8.1",
    "dexie": "4.4.7",
    "leaflet": "1.9.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "1.63.0",
    "@types/leaflet": "1.9.14",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "fake-indexeddb": "6.2.8",
    "typescript": "5.6.3",
    "vite": "6.0.3",
    "vite-plugin-pwa": "0.21.2",
    "vitest": "3.0.5",
    "workbox-window": "7.3.0"
  }
}
